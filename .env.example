# Neon Postgres Connection String
# IMPORTANT: For Cloudflare Pages deployment, this DATABASE_URL must also be set as an environment variable/secret
# in Cloudflare Pages Dashboard -> Settings -> Variables and secrets (for both Production and Preview environments),
# because Cloudflare Pages does not read local .env files at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Production domain / Site URL for sitemap, canonical URLs, and Open Graph metadata
NEXT_PUBLIC_SITE_URL="https://weatherhub.ru"

# Optional: Sentry error monitoring DSN (if unconfigured, app operates normally with safe fallback)
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@weatherhub.ru"

# Upstash Redis for Distributed Rate Limiting
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"


