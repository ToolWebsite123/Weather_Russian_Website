# Neon Postgres Connection String
# IMPORTANT: For Cloudflare Pages deployment, this DATABASE_URL must also be set as an environment variable/secret
# in Cloudflare Pages Dashboard -> Settings -> Variables and secrets (for both Production and Preview environments),
# because Cloudflare Pages does not read local .env files at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: Sentry error monitoring DSN (if unconfigured, app operates normally with safe fallback)
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
